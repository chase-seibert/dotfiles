# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.cache
nosetests.xml
coverage.xml

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

ssh/config

# macOS metadata
.DS_Store

# Codex app state. Keep codex/ as an allowlisted dotfile mirror.
.codex/
codex/*
codex/.*
!codex/AGENTS.md
!codex/config.toml
!codex/agents/
codex/agents/*
codex/agents/.*
!codex/agents/.gitignore
!codex/agents/*.md
!codex/docs/
codex/docs/*
codex/docs/.*
!codex/docs/create-project.md
!codex/skills/
codex/skills/.*
!codex/skills/.gitignore
